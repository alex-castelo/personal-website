---
import { portfolio as p } from '../data/portfolio';
---

<section id="about" class="pf-section">
  <div class="pf-secthead">
    <div class="pf-secthead__num" aria-hidden="true">01</div>
    <h2 class="pf-secthead__title">How I think</h2>
  </div>
  <div class="pf-about__body">
    <div class="pf-about__prose">
      {p.about.map((text) => (
        <p class="pf-about__p">{text}</p>
      ))}
    </div>
  </div>
</section>
