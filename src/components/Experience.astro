---
import { portfolio as p } from '../data/portfolio';
---

<section id="work" class="pf-section">
  <div class="pf-secthead">
    <div class="pf-secthead__num" aria-hidden="true">02</div>
    <h2 class="pf-secthead__title">Selected work</h2>
  </div>
  <div class="pf-exp">
    {p.experience.map((role) => (
      <article class="pf-exp__row">
        <div class="pf-exp__meta">
          <time class="pf-exp__dates">{role.dates}</time>
          <h3 class="pf-exp__company">{role.company}</h3>
          <div class="pf-exp__role">{role.role}</div>
          <div class="pf-exp__duration">{role.duration}</div>
        </div>
        <p class="pf-exp__narr">
          {typeof role.narrative === 'string'
            ? role.narrative
            : role.narrative.map((part) =>
                typeof part === 'string' ? part : (
                  <a href={part.href} target="_blank" rel="noreferrer" class="pf-exp__link">
                    {part.text}<span class="sr-only"> (opens in new tab)</span>
                  </a>
                )
              )}
        </p>
      </article>
    ))}
  </div>
</section>
